<Window
    x:Class="findrbordr.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Finder Border Frame"
    Width="1200"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  =========================================================  -->
        <!--  4. Pure Cosmetic Outer Border Frame Wrapper (22px Corner)  -->
        <!--  =========================================================  -->
        <!--
            Spans across the entire grid layout window area to cleanly
            draw the missing right side and bottom side edge trims.
        -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="Transparent"
            BorderBrush="White"
            BorderThickness="11,11,11,11"
            CornerRadius="23,23,23,23"
            IsHitTestVisible="False" />
        <!--  1. Top Toolbar Area (macOS Finder Style)  -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,4,0,4"
            Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform Y="3" />
            </Grid.RenderTransform>
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="3,0" />
                    <!--  Adjust this (e.g. 6,0 or 8,0) for more gap  -->
                </Style>
                <!--  Common Capsule Style  -->
                <Style x:Key="CapsuleStyle" TargetType="Border">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.1"
                                ShadowDepth="5"
                                Color="#000000" />
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  Common Button Template for Icons  -->
                <ControlTemplate x:Key="ToolButtonTemplate" TargetType="Button">
                    <Border
                        x:Name="btnBorder"
                        Margin="0"
                        Background="Transparent"
                        CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#E5E5E5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#D8D8D8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!--  1. Nav Capsule  -->
                <ColumnDefinition Width="*" />
                <!--  2. WebView Title/Address Bar  -->
                <ColumnDefinition Width="Auto" />
                <!--  3. View Modes Capsule  -->
                <ColumnDefinition Width="Auto" />
                <!--  4. Preview Toggle Capsule  -->
                <ColumnDefinition Width="Auto" />
                <!--  5. File/Folder Options Capsule  -->
                <ColumnDefinition Width="Auto" />
                <!--  6. Search Circle  -->
            </Grid.ColumnDefinitions>

            <!--  =========================================================  -->
            <!--  CAPSULE 1: BACK / FORWARD  -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="0"
                Margin="8,0,18,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <!--  Back  -->
                    <Button
                        x:Name="BtnBack"
                        Width="26"
                        Height="24"
                        Click="BtnBack_Click"
                        Content="‹"
                        Cursor="Hand"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Back" />
                    <Button
                        
                        x:Name="BtnUp"
                        Width="2"
                        Height="24"
                        Click="BtnUp_Click"
                        Content="|"
                        Cursor="Hand"
                        FontSize="16"
                        ToolTip="Up" />
                    <!--  Forward  -->
                    <Button
                        x:Name="BtnForward"
                        Width="26"
                        Height="24"
                        Click="BtnForward_Click"
                        Content="›"
                        Cursor="Hand"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Forward" />
                </StackPanel>
            </Border>

            <!--  =========================================================  -->
            <!--  CENTER: WEBVIEW TOOLBAR (Address/Path Display)  -->
            <!--  =========================================================  -->
            <wv2:WebView2
                Name="WebViewToolbar"
                Grid.Column="1"
                DefaultBackgroundColor="Transparent" />
                

            <!--  =========================================================  -->
            <!--  CAPSULE 2: VIEW MODES (Icons / List / Details / Tiles)  -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="2"
                Margin="16,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <!--  Thumbnail / Icons View  -->
                    <Button
                        x:Name="BtnViewIcons"
                        Width="26"
                        Height="24"
                        Click="BtnViewIcons_Click"
                        Content="░"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Icons View" />
                    <!--  List View  -->
                    <Button
                        x:Name="BtnViewList"
                        Width="26"
                        Height="24"
                        Click="BtnViewList_Click"
                        Content="▥"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="List View" />
                    <!--  Details / Columns View  -->
                    <Button
                        x:Name="BtnViewDetails"
                        Width="26"
                        Height="24"
                        Click="BtnViewDetails_Click"
                        Content="≡"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Details View" />
                    <!--  Tiles View  -->
                    <Button
                        x:Name="BtnViewTiles"
                        Width="26"
                        Height="24"
                        Click="BtnViewTiles_Click"
                        Content="⊞"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Tiles View" />
                </StackPanel>
            </Border>

            <!--  =========================================================  -->
            <!--  CAPSULE 3: PREVIEW PANES (Show/Hide & Toggle Details)  -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="3"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <!--  Show/Hide Preview Pane (Alt+P)  -->
                    <Button
                        x:Name="BtnTogglePreview"
                        Width="26"
                        Height="24"
                        Click="BtnTogglePreview_Click"
                        Content="◧"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Toggle Preview Pane" />
                    <Rectangle
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        Fill="#DCDCDC" />
                    <!--  Toggle Details Pane (Shift+Alt+P)  -->
                    <Button
                        x:Name="BtnToggleDetailsPane"
                        Width="26"
                        Height="24"
                        Click="BtnToggleDetailsPane_Click"
                        Content="◨"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Toggle Details Pane" />
                </StackPanel>
            </Border>

            <!--  =========================================================  -->
            <!--  CAPSULE 4: FILE / FOLDER OPTIONS  -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="4"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <!--  File / Folder Properties  -->
                    <Button
                        x:Name="BtnProperties"
                        Width="26"
                        Height="24"
                        Click="BtnProperties_Click"
                        Content="ⓘ"
                        Cursor="Hand"
                        FontSize="18"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Properties" />
                    <!--  Folder Options  -->
                    <Button
                        x:Name="BtnFolderOptions"
                        Width="26"
                        Height="24"
                        Click="BtnFolderOptions_Click"
                        Content="⚙"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Folder Options" />
                    <!--  Context Menu (Shift+F10)  -->
                    <Button
                        x:Name="BtnContextMenu"
                        Width="26"
                        Height="24"
                        Click="BtnContextMenu_Click"
                        Content="•••"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#4A4A4A"
                        Template="{StaticResource ToolButtonTemplate}"
                        ToolTip="Context Menu" />
                </StackPanel>
            </Border>

            <!--  =========================================================  -->
            <!--  CIRCLE: SEARCH BUTTON  -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="5"
                Width="32"
                Height="32"
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.1"
                        ShadowDepth="5"
                        Color="#000000" />
                </Border.Effect>
                <Button
                    x:Name="BtnSearch"
                    Click="BtnSearch_Click"
                    Content="🔍"
                    Cursor="Hand"
                    FontSize="16"
                    Foreground="#4A4A4A"
                    Template="{StaticResource ToolButtonTemplate}"
                    ToolTip="Search (Ctrl+F)" />
            </Border>
        </Grid>
        <!--  2. Left Sidebar Area  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0">

            <!--  BORDER LATAR BELAKANG DENGAN SHADOW  -->
            <Border
                Margin="7"
                Background="White"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="30"
                        Direction="0"
                        Opacity="0.25"
                        ShadowDepth="5"
                        Color="Black" />
                </Border.Effect>
            </Border>

            <!--  WEBVIEW2 DI ATAS BORDER  -->
            <wv2:WebView2 Name="WebViewSidebar" DefaultBackgroundColor="Transparent" />
        </Grid>
        <!--  3. Center Cutout Void  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Background="Transparent"
            IsHitTestVisible="False" />


    </Grid>
</Window>
